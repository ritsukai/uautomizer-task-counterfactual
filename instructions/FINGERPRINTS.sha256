f1c27440c7763a548d5a0e23b46ee756e27ec38cb66a7c4206d1c0dc8488e21c  instruction-B.md
b37ab6d913def7b4083bf25b5c6685d7a7a3398f0bf627c47efe44d63b3df196  instruction-C.md
