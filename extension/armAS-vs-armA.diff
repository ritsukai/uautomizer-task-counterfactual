diff -ru ~/tb-1541/run/arms/armA/fix-uautomizer-soundness/environment/Dockerfile ~/tb-1541/run/arms/armAS/fix-uautomizer-soundness/environment/Dockerfile
--- ~/tb-1541/run/arms/armA/fix-uautomizer-soundness/environment/Dockerfile	2026-08-13 16:30:03
+++ ~/tb-1541/run/arms/armAS/fix-uautomizer-soundness/environment/Dockerfile	2026-08-17 11:06:41
@@ -38,6 +38,20 @@
 # Use system z3 so the bundled binary doesn't cause libc issues
 RUN cp "$(which z3)" /app/ultimate/z3 && chmod +x /app/ultimate/z3
 
+# ── Extension A2: strip the build-commit identifier (see extension/EXTENSION-DESIGN.md) ──
+# Site 1: the Python wrapper hardcodes and prints the commit hash.
+RUN sed -i "s/version = '0e0057cc'/version = '00000000'/" /app/ultimate/Ultimate.py && \
+    ! grep -q "0e0057cc" /app/ultimate/Ultimate.py
+# Site 2: version.properties inside the core jar carries the full 40-char commit id,
+# which the Java banner ("This is Ultimate 0.2.4-dev-...") reads at runtime.
+RUN cd /tmp && \
+    unzip -o /app/ultimate/plugins/de.uni_freiburg.informatik.ultimate.core_0.2.4.jar version.properties && \
+    sed -i -e "s/^git.commit.id=.*/git.commit.id=0000000000000000000000000000000000000000/" \
+           -e "s/^git.commit.id.abbrev=.*/git.commit.id.abbrev=0000000/" version.properties && \
+    jar uf /app/ultimate/plugins/de.uni_freiburg.informatik.ultimate.core_0.2.4.jar version.properties && \
+    rm version.properties && \
+    ! (unzip -p /app/ultimate/plugins/de.uni_freiburg.informatik.ultimate.core_0.2.4.jar version.properties | grep -q "0e0057c")
+
 # Reduce JVM heap ceiling so the container doesn't need 12 GB
 RUN sed -i 's/-Xmx12G/-Xmx4G/g' /app/ultimate/Ultimate.ini && \
     sed -i 's|@user.home/.ultimate|/tmp/.ultimate|g' /app/ultimate/Ultimate.ini
